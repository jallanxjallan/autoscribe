filters:
  and:
    - "!slug.isEmpty()"
    - file.folder == "Content"
views:
  - type: table
    name: Status
    groupBy:
      property: stage
      direction: ASC
    order:
      - file.name
      - action
      - state
  - type: table
    name: Order
    filters:
      and:
        - section == 1
        - component == "narrative"
    order:
      - file.name
      - section
      - position
      - component
      - group
      - stage
      - action
    sort:
      - property: section
        direction: ASC
      - property: position
        direction: ASC
    columnSize:
      note.position: 92
