filters:
  and:
    - file.folder == "Materials"
views:
  - type: table
    name: Table
    order:
      - selected
      - action
      - file.name
      - tags
  - type: table
    name: Selected
    filters:
      and:
        - selected == true
        - file.folder == "materials"
    order:
      - file.name
      - slug
