filters:
  and:
    - "!slug.isEmpty()"
views:
  - type: table
    name: Table
    filters:
      and:
        - selected == false
    order:
      - slug
      - stage
      - status
    sort:
      - property: stage
        direction: DESC
      - property: tags
        direction: ASC
      - property: status
        direction: ASC
      - property: formula.Untitled
        direction: ASC
  - type: cards
    name: View
    filters:
      and:
        - stage == "final"
    order:
      - file.name
      - kind
      - class
      - origin
      - stage
      - status
    imageAspectRatio: 1.2
  - type: table
    name: Selected
    filters:
      and:
        - selected == true
    order:
      - file.name
      - slug
  - type: table
    name: Review
    filters:
      and:
        - file.folder == "contents"
        - status == "review"
        - or:
            - "!stage.isEmpty()"
    groupBy:
      property: stage
      direction: ASC
    order:
      - file.name
      - selected
      - stage
      - status
      - tags
    sort:
      - property: stage
        direction: DESC
  - type: table
    name: Contents
    filters:
      and:
        - file.folder == "contents"
    groupBy:
      property: class
      direction: ASC
    order:
      - selected
      - file.name
      - origin
      - file.tags
    sort:
      - property: selected
        direction: DESC
      - property: class
        direction: ASC
      - property: file.name
        direction: ASC
      - property: file.tags
        direction: ASC
      - property: file.mtime
        direction: ASC
    columnSize:
      note.origin: 184
  - type: table
    name: Instructions
    filters:
      and:
        - file.folder == "instructions"
    order:
      - file.name
      - role
      - context
      - file.mtime
  - type: table
    name: Drafts
    filters:
      and:
        - stage != "final"
        - and:
            - file.folder == "contents"
    groupBy:
      property: stage
      direction: ASC
    order:
      - selected
      - file.name
      - stage
      - status
      - file.mtime
      - action
    sort:
      - property: status
        direction: ASC
  - type: table
    name: Final
    filters:
      and:
        - file.folder == "contents"
        - stage == "final"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - action
    sort:
      - property: action
        direction: ASC
