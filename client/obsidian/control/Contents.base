filters:
  and:
    - "!slug.isEmpty()"
views:
  - type: table
    name: Table
    filters:
      and:
        - selected == false
    order:
      - slug
      - stage
      - status
    sort:
      - property: stage
        direction: DESC
      - property: tags
        direction: ASC
      - property: status
        direction: ASC
      - property: formula.Untitled
        direction: ASC
  - type: cards
    name: View
    filters:
      and:
        - stage == "final"
    order:
      - file.name
      - kind
      - class
      - origin
      - stage
      - status
    imageAspectRatio: 1.2
  - type: table
    name: Selected
    filters:
      and:
        - selected == true
    order:
      - file.name
      - slug
  - type: table
    name: State
    filters:
      and:
        - file.folder == "contents"
    groupBy:
      property: state
      direction: ASC
    order:
      - selected
      - file.name
      - stage
      - status
    sort:
      - property: stage
        direction: DESC
      - property: status
        direction: ASC
  - type: table
    name: Contents
    filters:
      and:
        - file.folder == "contents"
    groupBy:
      property: class
      direction: ASC
    order:
      - selected
      - file.name
      - origin
      - file.mtime
      - file.tags
    sort:
      - property: selected
        direction: DESC
      - property: class
        direction: ASC
      - property: file.name
        direction: ASC
      - property: file.tags
        direction: ASC
      - property: file.mtime
        direction: ASC
  - type: table
    name: Instructions
    filters:
      and:
        - file.folder == "instructions"
    order:
      - file.name
      - role
      - context
      - file.mtime
  - type: table
    name: Stage
    filters:
      and:
        - and:
            - file.folder == "contents"
    groupBy:
      property: stage
      direction: ASC
    order:
      - selected
      - file.name
      - status
      - state
  - type: table
    name: Action
    filters:
      and:
        - file.folder == "contents"
    groupBy:
      property: action
      direction: ASC
    order:
      - selected
      - file.name
      - stage
      - status
    sort:
      - property: status
        direction: ASC
  - type: table
    name: Status
    filters:
      and:
        - file.folder == "contents"
    groupBy:
      property: status
      direction: ASC
    order:
      - selected
      - file.name
      - stage
      - state
