\
    #!/usr/bin/env bash
    set -euo pipefail

    # AutoScribe control-repository receive hook.
    #
    # Configuration has exactly one server-side Git source in the prototype:
    # the unified AutoScribe Control bare repository. Vault/project repositories
    # are content/run repositories and must not materialize plans/instructions.

    REPO="$(git rev-parse --absolute-git-dir)"
    ASC="${AUTOSCRIBE_ASC:-/home/jeremy/Python3.13Env/bin/asc}"

    repo_id="$(git config --get autoscribe.repo-id || true)"
    repo_kind="$(git config --get autoscribe.repo-kind || true)"
    ingest_ref="$(git config --get autoscribe.ingest-ref || true)"

    [[ -n "$repo_id" ]] || repo_id="autoscribe-control"
    [[ -n "$repo_kind" ]] || repo_kind="control"
    [[ -n "$ingest_ref" ]] || ingest_ref="refs/heads/master"

    if [[ "$repo_kind" != "control" ]]; then
      printf 'AutoScribe control hook refused non-control repo_kind=%s repo=%s\n' \
        "$repo_kind" "$REPO" >&2
      exit 1
    fi

    if [[ "$ingest_ref" != "refs/heads/master" ]]; then
      printf 'AutoScribe control hook requires refs/heads/master; got %s\n' \
        "$ingest_ref" >&2
      exit 1
    fi

    [[ -x "$ASC" ]] || {
      printf 'AutoScribe asc executable not found: %s\n' "$ASC" >&2
      exit 1
    }

    zero="0000000000000000000000000000000000000000"

    while read -r oldrev newrev refname; do
      [[ "$refname" == "$ingest_ref" ]] || continue
      [[ "$newrev" != "$zero" ]] || continue

      args=(
        ingest
        --repo-id "$repo_id"
        --repo-kind control
        --trigger-ref "$refname"
      )

      if [[ "$oldrev" == "$zero" ]]; then
        args+=(--full)
      else
        args+=(--base "$oldrev")
      fi

      # Typer options precede the positional REPOSITORY REVISION arguments.
      args+=("$REPO" "$newrev")
      "$ASC" "${args[@]}"
    done
