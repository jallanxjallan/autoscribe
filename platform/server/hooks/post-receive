#!/usr/bin/env bash
set -euo pipefail

# AutoScribe server-side configuration ingestion hook.
# Git invokes post-receive from the repository that accepted the push. Preserve
# that repository as the provenance boundary rather than treating incoming JSON
# as anonymous configuration.

ASC_BIN="${AUTOSCRIBE_ASC_BIN:-asc}"
REPO="$(git rev-parse --absolute-git-dir)"
REPO_ID="$(git config --get autoscribe.repo-id || true)"
REPO_KIND="$(git config --get autoscribe.repo-kind || true)"
INGEST_REF="$(git config --get autoscribe.ingest-ref || true)"

[[ -n "$REPO_ID" ]] || REPO_ID="$(basename "$REPO" .git)"
[[ -n "$REPO_KIND" ]] || REPO_KIND="project"
[[ -n "$INGEST_REF" ]] || INGEST_REF="refs/heads/autoscribe/config"

zero=0000000000000000000000000000000000000000

while read -r oldrev newrev refname; do
    [[ "$refname" == "$INGEST_REF" ]] || continue
    [[ "$newrev" != "$zero" ]] || continue

    args=(
        ingest "$REPO" "$newrev"
        --repo-id "$REPO_ID"
        --repo-kind "$REPO_KIND"
        --trigger-ref "$refname"
    )

    if [[ "$oldrev" == "$zero" ]]; then
        args+=(--full)
    else
        args+=(--base "$oldrev")
    fi

    "$ASC_BIN" "${args[@]}"
done
