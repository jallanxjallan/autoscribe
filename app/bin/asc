#!/usr/bin/env python3
from __future__ import annotations
import os, sys
from pathlib import Path
APP_ROOT=Path(__file__).resolve().parents[1]
if str(APP_ROOT) not in sys.path: sys.path.insert(0,str(APP_ROOT))
from autoscribe.control import list_plans

def main() -> int:
    args=sys.argv[1:]
    if args==["control","plans"]:
        db=Path(os.environ.get("AUTOSCRIBE_CONTROL_DB",str(Path.home()/"Data/control.sql")))
        for row in list_plans(db): print(f"{row['label']}\t{row['id']}")
        return 0
    print("usage: asc control plans",file=sys.stderr); return 2
if __name__=="__main__": raise SystemExit(main())
